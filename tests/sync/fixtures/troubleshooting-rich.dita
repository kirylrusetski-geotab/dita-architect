<!DOCTYPE troubleshooting PUBLIC "-//OASIS//DTD DITA Troubleshooting//EN" "troubleshooting.dtd">
<troubleshooting id="troubleshooting-fixture" xml:lang="en-us" class="- topic/topic troubleshooting/troubleshooting "><title class="- topic/title ">Troubleshooting a device that does not report</title><shortdesc class="- topic/shortdesc ">Learn how to resolve a device that stops sending data.</shortdesc><troublebody class="- topic/body troubleshooting/troublebody "><condition class="- topic/section troubleshooting/condition "><title class="- topic/title ">Symptoms</title><p class="- topic/p ">The device shows as <uicontrol class="+ topic/ph ui-d/uicontrol ">Not communicating</uicontrol> and the last <keyword class="- topic/keyword ">heartbeat</keyword> is more than 24 hours old.</p></condition><troubleSolution class="- topic/bodydiv troubleshooting/troubleSolution "><cause class="- topic/section troubleshooting/cause "><p class="- topic/p ">The device has no power.<ul class="- topic/ul "><li class="- topic/li "><p class="- topic/p ">Check that the harness is seated.</p></li><li class="- topic/li "><p class="- topic/p ">Check the vehicle fuse.</p></li></ul></p></cause><remedy class="- topic/section troubleshooting/remedy "><title class="- topic/title ">Restore power</title><steps-unordered class="- topic/ul task/steps-unordered "><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Reseat the harness connector.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Replace the fuse if it has blown.</cmd><info class="- topic/itemgroup task/info "><p class="- topic/p ">Use a fuse of the same rating.</p></info></step></steps-unordered></remedy></troubleSolution><troubleSolution class="- topic/bodydiv troubleshooting/troubleSolution "><cause class="- topic/section troubleshooting/cause "><p class="- topic/p ">The device is out of cellular coverage.</p></cause><remedy class="- topic/section troubleshooting/remedy "><steps-informal class="- topic/ol task/steps-informal "><p class="- topic/p ">Move the vehicle to an area with coverage and wait for the next scheduled upload.</p><ol class="- topic/ol "><li class="- topic/li "><p class="- topic/p ">Confirm the signal indicator.</p></li><li class="- topic/li "><p class="- topic/p ">Refresh the device page.</p></li></ol></steps-informal></remedy></troubleSolution><troubleSolution class="- topic/bodydiv troubleshooting/troubleSolution "><cause class="- topic/section troubleshooting/cause "/><remedy class="- topic/section troubleshooting/remedy "><steps class="- topic/ol task/steps "><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Contact support with the device serial number.</cmd></step></steps></remedy></troubleSolution></troublebody></troubleshooting>
