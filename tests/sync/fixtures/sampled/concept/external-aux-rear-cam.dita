<concept id="external-aux-rear-cam" class="- topic/topic concept/concept "><title class="- topic/title ">External Aux Rear Cam - USB</title><shortdesc class="- topic/shortdesc ">External rear auxiliary camera with IP69K weatherproofing, compatible with the <ph conkeyref="varsCamProdSKU/name-go-focus-plus" class="- topic/ph "/> and <ph conkeyref="varsCamProdSKU/name-go-focus-pro" class="- topic/ph "/>.</shortdesc><conbody class="- topic/body  concept/conbody "><image placement="break" href="../../Images/GO_Focus_accessories/hdw-gfpu10cam.png" class="- topic/image "><alt class="- topic/alt ">External Aux Rear Cam</alt></image><section id="technical-specifications" class="- topic/section "><simpletable class="- topic/simpletable "><strow class="- topic/strow "><stentry class="- topic/stentry "><p class="- topic/p ">Compatibility</p></stentry><stentry class="- topic/stentry "><p class="- topic/p "><ph conkeyref="varsCamProdSKU/name-go-focus-plus" class="- topic/ph "/> (<ph conkeyref="varsCamProdSKU/sku-ext-rear-cam-mini-usb" class="- topic/ph "/> only), <ph conkeyref="varsCamProdSKU/name-go-focus-pro" class="- topic/ph "/></p></stentry></strow><strow class="- topic/strow "><stentry class="- topic/stentry "><p class="- topic/p ">AI Inferencing Support</p></stentry><stentry class="- topic/stentry "><p class="- topic/p ">No</p></stentry></strow><strow class="- topic/strow "><stentry class="- topic/stentry "><p class="- topic/p ">Video Resolution</p></stentry><stentry class="- topic/stentry "><p class="- topic/p ">1080p</p></stentry></strow><strow class="- topic/strow "><stentry class="- topic/stentry "><p class="- topic/p ">Field of View (D/H/V)</p></stentry><stentry class="- topic/stentry "><p class="- topic/p ">139°/120°/67°</p></stentry></strow><strow class="- topic/strow "><stentry class="- topic/stentry "><p class="- topic/p ">IR Illumination</p></stentry><stentry class="- topic/stentry "><p class="- topic/p ">850 nm</p></stentry></strow><strow class="- topic/strow ">