<task id="task-4579" class="- topic/topic task/task "><title class="- topic/title ">Editing a contact</title><shortdesc class="- topic/shortdesc ">Update the name, role, or contact details of a person on a Customer account.</shortdesc><taskbody class="- topic/body task/taskbody "><prereq class="- topic/section task/prereq "><p class="- topic/p ">You must have the <b class="+ topic/ph hi-d/b ">Contact.Admin</b> role to complete this task.</p></prereq><context class="- topic/section task/context "/><steps class="- topic/ol task/steps "><step conref="../../../Content_Warehouses/MyAdmin/Reusable_Steps/Finding_a_Customer.dita#task-5129/step-2982" class="- topic/li task/step "><cmd class="- topic/ph task/cmd "/></step><step conref="../../../Content_Warehouses/MyAdmin/Reusable_Steps/Finding_a_Customer.dita#task-5129/step-3609" class="- topic/li task/step "><cmd class="- topic/ph task/cmd "/></step><step conref="../../../Content_Warehouses/MyAdmin/Reusable_Steps/Finding_a_Customer.dita#task-5129/step-916" class="- topic/li task/step "><cmd class="- topic/ph task/cmd "/></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Go to the <uicontrol class="+ topic/ph ui-d/uicontrol ">Contacts</uicontrol> tab, then select a contact name.</cmd><stepresult class="- topic/itemgroup task/stepresult ">A popup is displayed.</stepresult></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Update the relevant fields.</cmd></step><step class="- topic/li task/step "><cmd class="- topic/ph task/cmd ">Click <uicontrol class="+ topic/ph ui-d/uicontrol ">Save</uicontrol>.</cmd></step></steps><result class="- topic/section task/result "><p class="- topic/p ">The contact has been updated.</p></result></taskbody></task>