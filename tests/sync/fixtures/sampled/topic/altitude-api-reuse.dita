<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="topic-5102" xml:lang="en-us" class="- topic/topic "><title class="- topic/title ">Altitude API Parameters Reuse</title><shortdesc class="- topic/shortdesc "/><body class="- topic/body "><section class="- topic/section ">
            <table class="- topic/table "><tgroup cols="5" class="- topic/tgroup "><colspec colname="c1" colnum="1" colwidth="1*" class="- topic/colspec "/><colspec colname="c2" colnum="2" class="- topic/colspec "/><colspec colname="c3" colnum="3" class="- topic/colspec "/><colspec colname="c4" colnum="4" class="- topic/colspec "/><colspec colname="c5" colnum="5" class="- topic/colspec "/><thead class="- topic/thead "><row class="- topic/row "><entry class="- topic/entry ">Parameter</entry><entry class="- topic/entry ">Description</entry><entry class="- topic/entry ">Type</entry><entry class="- topic/entry ">Defined Value Set</entry><entry class="- topic/entry ">Value Required</entry></row></thead><tbody class="- topic/tbody "><row id="row-7436" class="- topic/row "><entry class="- topic/entry "> vehicleClasses</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">An array of vehicle class objects where each object contains <codeph class="+ topic/ph pr-d/codeph ">VehicleType</codeph> and <codeph class="+ topic/ph pr-d/codeph ">WeightClass</codeph>. To get the list of possible vehicle types and weight classes, refer to <ph conkeyref="varsAltitudeXREF/AltitudeVehicleTypes" class="- topic/ph "/> and <ph conkeyref="varsAltitudeXREF/AltitudeWeightClass" class="- topic/ph "/> tables. If a vehicle type does not have any weight classes listed, just pass "*". More information on vehicle classes can be found at <ph conkeyref="varsAltitudeXREF/AltitudeAFDCCategories" class="- topic/ph "/>. To get all vehicle classes returned, pass an empty array.</p>
                            </entry><entry class="- topic/entry ">ARRAY</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">See the <ph conkeyref="varsAltitudeXREF/AltitudeVehicleTypes" class="- topic/ph "/> and <ph conkeyref="varsAltitudeXREF/AltitudeWeightClass" class="- topic/ph "/> tables.</p>
                                <p class="- topic/p ">For Vehicle Type: "Truck", "Passenger", "MPV", "Bus", "Other". More information at <ph conkeyref="varsAltitudeXREF/AltitudeAFDCCategories" class="- topic/ph "/>.</p>
                                <p class="- topic/p ">To get all vehicle types, pass an empty array.</p>
                            </entry><entry class="- topic/entry ">N</entry></row><row id="row-8090" class="- topic/row "><entry class="- topic/entry ">vehicleClassSchemeId</entry><entry class="- topic/entry ">Determines which vehicle classification scheme you will receive data for. See the <ph conkeyref="varsAltitudeXREF/AltitudeVehicleClassSchemas" class="- topic/ph "/> for a list of options. The default value is 2.</entry><entry class="- topic/entry ">INTEGER</entry><entry class="- topic/entry ">[1,4]</entry><entry class="- topic/entry ">N</entry></row><row id="row-6675-od" class="- topic/row "><entry class="- topic/entry ">aggregationUnits</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">Array of requested time series aggregation units to be included in time series breakdowns. This attribute determines which time series breakdowns are generated if <codeph class="+ topic/ph pr-d/codeph ">generateTimeSeries</codeph> is set to true. Supported values (not case-sensitive) are:</p>
                                <ul class="- topic/ul "><li class="- topic/li ">
                                        <p class="- topic/p ">hour - for a breakdown by hour from 0 to 23.</p>
                                    </li><li class="- topic/li ">
                                        <p class="- topic/p ">daytype - for a breakdown by day-of-week, where “Weekend” = [1,7] or Saturday through Sunday, and “Weekday” = [2,3,4,5,6] or Monday through Friday.</p>
                                    </li><li class="- topic/li ">
                                        <p class="- topic/p ">daytypehour - for a breakdown by day type (“Weekend”, “Weekday”) and hour from 0 to 23.</p>
                                    </li></ul>
                            </entry><entry class="- topic/entry ">ARRAY</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">“hour”,</p>
                                <p class="- topic/p ">“daytype”,</p>
                                <p class="- topic/p ">“daytypehour” </p>
                            </entry><entry class="- topic/entry ">N</entry></row><row id="row-6675" class="- topic/row "><entry class="- topic/entry ">aggregationUnits</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">Array of requested time series aggregation units to be included in time series breakdowns. This attribute determines which time series breakdowns are generated if <codeph class="+ topic/ph pr-d/codeph ">generateTimeSeries</codeph> is set to true. Supported values (not case-sensitive) are:</p>
                                <ul class="- topic/ul "><li class="- topic/li ">
                                        <p class="- topic/p ">hour - for a breakdown by hour from 0 to 23.</p>
                                    </li><li class="- topic/li ">
                                        <p class="- topic/p ">dayofweek - for a breakdown by day of week, where Sunday is 1 and Saturday is 7.</p>
                                    </li><li class="- topic/li ">
                                        <p class="- topic/p ">month - for a breakdown by month number.</p>
                                    </li></ul>
                            </entry><entry class="- topic/entry ">ARRAY</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">"hour",</p>
                                <p class="- topic/p ">"dayofweek",</p>
                                <p class="- topic/p ">"month"</p>
                            </entry><entry class="- topic/entry ">N</entry></row><row id="row-6675-rtm" class="- topic/row "><entry class="- topic/entry ">aggregationUnits</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">Array of requested time series aggregation units to be included in time series breakdowns. This attribute determines which time series breakdowns are generated if <codeph class="+ topic/ph pr-d/codeph ">generateTimeSeries</codeph> is set to true. Supported values (not case-sensitive) are:</p>
                                <ul class="- topic/ul "><li class="- topic/li ">
                                        <p class="- topic/p ">hour - for a breakdown by hour of the day from 0 to 23.</p>
                                    </li><li class="- topic/li ">
                                        <p class="- topic/p ">hourofday - for a breakdown by a specific hour timestamp.</p>
                                    </li><li class="- topic/li ">
                                        <p class="- topic/p ">dayofweek - for a breakdown by day of week, where Sunday is 1 and Saturday is 7.</p>
                                    </li><li class="- topic/li ">
                                        <p class="- topic/p ">day - for a breakdown by a specific date.</p>
                                    </li><li class="- topic/li ">
                                        <p class="- topic/p ">month - for a breakdown by month number.</p>
                                    </li></ul>
                            </entry><entry class="- topic/entry ">ARRAY</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">"hour",</p>
                                <p class="- topic/p ">"hourofday",</p>
                                <p class="- topic/p ">"dayofweek",</p>
                                <p class="- topic/p ">"day",</p>
                                <p class="- topic/p ">"month"</p>
                            </entry><entry class="- topic/entry ">N</entry></row><row class="- topic/row "><entry class="- topic/entry ">aggregateAllZones</entry><entry class="- topic/entry ">Whether to aggregate the results over all zones (true) or report the results for each zone provided (false). The default is false.</entry><entry class="- topic/entry ">BOOLEAN</entry><entry class="- topic/entry ">True or False</entry><entry class="- topic/entry ">N</entry></row><row id="row-7772" class="- topic/row "><entry class="- topic/entry ">daysOfWeek</entry><entry class="- topic/entry ">Array of integers representing each week day. Can send an empty array to return all days.</entry><entry class="- topic/entry ">ARRAY</entry><entry class="- topic/entry ">[1,7] (1 = Sunday, 2 = Monday, etc.)</entry><entry class="- topic/entry ">N</entry></row><row class="- topic/row "><entry class="- topic/entry ">excludeServiceRoads</entry><entry class="- topic/entry ">True to exclude service roads, false to include them. Defaults to true</entry><entry class="- topic/entry ">BOOLEAN</entry><entry class="- topic/entry ">-</entry><entry class="- topic/entry ">N</entry></row><row id="row-12348" class="- topic/row "><entry class="- topic/entry ">fuelTypes</entry><entry class="- topic/entry ">An array of strings representing the fuel types you want analyzed. Possible values are "Diesel", "Electric", "Flexible", "Gasoline", "Hybrid", "Other" and "Unknown". Refer to the <ph conkeyref="varsAltitudeXREF/AltitudeFuelTypes" class="- topic/ph "/> table for a description of each option. Can send an empty array to return all fuel types.</entry><entry class="- topic/entry ">ARRAY</entry><entry class="- topic/entry ">See <ph conkeyref="varsAltitudeXREF/AltitudeFuelTypes" class="- topic/ph "/> for a list of fuel types</entry><entry class="- topic/entry ">-</entry></row><row id="row-15582" class="- topic/row "><entry class="- topic/entry ">isMetric</entry><entry class="- topic/entry ">True for data to be returned in metric units, false for imperial.</entry><entry class="- topic/entry ">BOOLEAN</entry><entry class="- topic/entry ">True or False</entry><entry class="- topic/entry ">Y</entry></row><row id="row-4987" class="- topic/row "><entry class="- topic/entry ">generateTimeSeries</entry><entry class="- topic/entry ">
                                <p class="- topic/p ">An indicator of whether to generate a time series breakdown (true) or not (false) as a child analysis. Time series will be generated for each time aggregation in aggregationUnits.</p>
                                <note class="- topic/note "><p class="- topic/p ">The time series breakdown results can be retrieved using the <codeph class="+ topic/ph pr-d/codeph ">getSavedResults</codeph> API. See <ph conkeyref="varsAltitudeXREF/AltitudeTSR" class="- topic/ph "/> .</p></note>
                            </entry><entry class="- topic/entry ">BOOLEAN</entry><entry class="- topic/entry ">True or False</entry><entry class="- topic/entry ">Y</entry></row><row id="row-17531" class="- topic/row "><entry class="- topic/entry ">roadTypes</entry><entry class="- topic/entry ">An array of strings representing the different road types for which you want data. An empty array means all road types.</entry><entry class="- topic/entry ">ARRAY</entry><entry class="- topic/entry ">See   <ph conkeyref="varsAltitudeXREF/AltitudeRoadTypes" class="- topic/ph "/> in the Data Dictionary.</entry><entry class="- topic/entry ">N</entry></row></tbody></tgroup></table>
        </section><section id="responses" class="- topic/section "><title class="- topic/title ">Responses</title><table class="- topic/table "><tgroup cols="3" class="- topic/tgroup "><colspec colname="col1" colnum="1" class="- topic/colspec "/><colspec colname="col2" colnum="2" class="- topic/colspec "/><colspec colname="col3" colnum="3" class="- topic/colspec "/><thead class="- topic/thead "><row class="- topic/row "><entry class="- topic/entry ">Code</entry><entry class="- topic/entry ">Type</entry><entry class="- topic/entry ">Description</entry></row></thead><tbody class="- topic/tbody "><row class="- topic/row "><entry class="- topic/entry ">200</entry><entry class="- topic/entry ">JSON</entry><entry class="- topic/entry ">The requested data.</entry></row><row class="- topic/row "><entry class="- topic/entry ">401</entry><entry class="- topic/entry ">JSON</entry><entry class="- topic/entry ">Occurs for various unauthorized tasks, such as not providing credentials in your parameters.</entry></row><row class="- topic/row "><entry class="- topic/entry ">500</entry><entry class="- topic/entry ">JSON</entry><entry class="- topic/entry ">Occurs if an internal server error occurs. Contact <ph conkeyref="varsAltitudeXREF/AltitudeSupport" class="- topic/ph "/> if this occurs.</entry></row></tbody></tgroup></table></section></body></topic>